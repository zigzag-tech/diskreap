<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.diskreap.auto</string>
  <key>ProgramArguments</key><array><string>@BIN@</string><string>auto</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>19</integer>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:@HOME@/.cargo/bin</string></dict>
  <key>StandardOutPath</key><string>@HOME@/.local/state/diskreap/auto.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/diskreap/auto.log</string>
</dict>
</plist>
